# Application
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Paths
WEENY_DATA_DIR=
DATABASE_PATH=data/app.db
STORAGE_ROOT=storage
CATALOGUE_PATH=backend/app/data/catalogue.json
FRONTEND_DIR=frontend

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Upload limits
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MIN_IMAGE_SHORT_SIDE_PX=600
MAX_PHOTOS_PER_PROJECT=1
MAX_IMAGE_PIXELS=40000000
MAX_COMPONENTS_PER_PHOTO=60

# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹

# AI Configuration
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
NANO_BANANA_IMAGE_MODEL=gemini-3.1-flash-image
AI_MOCK_MODE=false
AI_MOCK_SCENARIO=ok
AI_WORKING_IMAGE_MAX_PX=1600
AI_DETECTION_TIMEOUT_S=60
AI_IMAGE_TIMEOUT_S=120
AI_MAX_RETRIES=1

# Logging
LOG_LEVEL=INFO
